
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AI Language Translator</title>
<link rel="stylesheet" href="style.css">
</head>
<body>

<div class="container">
    <h1>🌍 AI Language Translator</h1>
    <p>Translate text into different languages</p>

    <select id="source">
        <option value="autodetect">Detect Language</option>
        <option value="en">English</option>
        <option value="hi">Hindi</option>
        <option value="mr">Marathi</option>
        <option value="fr">French</option>
        <option value="es">Spanish</option>
    </select>

    <select id="target">
        <option value="hi">Hindi</option>
        <option value="en">English</option>
        <option value="mr">Marathi</option>
        <option value="fr">French</option>
        <option value="es">Spanish</option>
    </select>

    <textarea id="inputText" placeholder="Enter your text"></textarea>

    <button onclick="translateText()">Translate</button>

    <h3>Translated Text:</h3>
    <div id="result">Your translation appears here.</div>

    <button onclick="copyText()">Copy</button>
    <button onclick="speakText()">Listen 🔊</button>
</div>

<script src="script.js"></script>
</body>
</html>
